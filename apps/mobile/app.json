{
  "expo": {
    "name": "Prodhin",
    "slug": "prodhin-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "prodhin",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.aragontechsolutions.prodhin"
    },
    "android": {
      "package": "com.aragontechsolutions.prodhin",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#F59E0B"
      }
    },
    "plugins": [
      [
        "react-native-maps",
        {
          "androidApiKey": "TU_GOOGLE_MAPS_API_KEY_AQUI"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": ""
      }
    }
  }
}
