# Base de datos Supabase (Prisma)
# Usar Transaction pooler (puerto 6543) para DATABASE_URL con pgbouncer=true
DATABASE_URL=postgresql://postgres.XXXX:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Session pooler o direct connection para migraciones (puerto 5432)
DIRECT_URL=postgresql://postgres.XXXX:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# JWT — copiar desde Supabase > Settings > API > JWT Secret
JWT_SECRET=tu-supabase-jwt-secret

# CORS — URLs del frontend separadas por coma, sin slash final
ALLOWED_ORIGINS=https://tu-app.vercel.app,http://localhost:5173

# Puerto — Render lo inyecta automáticamente como $PORT
API_PORT=3000
